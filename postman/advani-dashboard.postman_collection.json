    {
      "name": "Auth",
      "item": [
        {
          "name": "GET /auth/config",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/config",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "config"]
            },
            "description": "Tells the login screen whether open signup is on."
          }
        },
        {
          "name": "POST /auth/request-otp",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/request-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "request-otp"]
            },
            "description": "Issues a six-digit code. Rate-limited to 5 per minute. While `EXPOSE_OTP` is on the code comes back as `devCode`, because email delivery is not wired up on this deployment.\n\nThe code is stored hashed, is single-use, expires after 10 minutes, and is capped at 5 wrong attempts."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.devCode) {",
                  "  pm.collectionVariables.set('otpCode', body.devCode);",
                  "  pm.test('code is six digits', () => {",
                  "    pm.expect(body.devCode).to.match(/^[0-9]{6}$/);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/verify-otp",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{otpCode}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-otp"]
            },
            "description": "Exchanges the code for an access token (15 minutes) and a refresh token (30 days). Run `request-otp` first — its test script captures `otpCode`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const session = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', session.accessToken);",
                  "pm.collectionVariables.set('refreshToken', session.refreshToken);",
                  "pm.collectionVariables.set('currentUserId', session.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] },
            "description": "The signed-in user, read fresh from the database rather than from the token."
          }
        },
        {
          "name": "POST /auth/refresh",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Rotates the refresh token. Sending the same token twice is treated as a leak: every session for that user is revoked and the call answers 401. Send this request twice in a row to see it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const session = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', session.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', session.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Revokes the presented session. Omit the body to revoke every session for the user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Clear the tokens so the next request signs in again.",
                  "pm.collectionVariables.set('accessToken', '');",
                  "pm.collectionVariables.set('refreshToken', '');"
                ]
              }
            }
          ]
        }
      ]
    },
