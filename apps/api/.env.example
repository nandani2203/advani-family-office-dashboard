# ─── Database (Supabase) ─────────────────────────────────────────────────────
# Pooled connection — used at runtime. Serverless functions open a connection
# per instance, so this must go through the pooler on port 6543.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection on 5432 — used only by `prisma migrate`, which cannot run
# through a transaction pooler.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ─── Tokens ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET="replace-me-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-me-with-a-different-32-plus-character-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# ─── Demo-mode auth ──────────────────────────────────────────────────────────
# OPEN_SIGNUP lets any email address sign in; the first account to do so becomes
# ADMIN. EXPOSE_OTP returns the code in the HTTP response because email delivery
# is not wired up — this is what lets a reviewer sign in without inbox access.
# Turn both off for a real deployment.
OPEN_SIGNUP="true"
EXPOSE_OTP="true"
OTP_TTL_MINUTES="10"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_SECONDS="30"

# ─── HTTP ────────────────────────────────────────────────────────────────────
PORT="4000"
# Comma-separated. Use "*" only for local development.
CORS_ORIGINS="http://localhost:3000"
